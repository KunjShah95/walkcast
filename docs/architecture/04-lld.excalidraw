   "updated": 1760600000000,
   "link": null,
   "locked": false,
   "text": "class Worker (jobs/worker.ts)\n──────────\nid = host-pid-uuid8\nstart() · poke() · stop(graceMs = 30 s)\nrun(): claim → execute | idle backoff\n  2 s ×2 → 10 s, ±10% jitter\nexecute(job):\n  heartbeat every max(1 s, lease/3)\n  margin check: abort if no ack > 80% lease\n  deadline LAB_JOB_DEADLINE_MS (6 min)\n  finish: flush progress, then fenced write\n  retry unless RecordError or aborted\n  finally: unregister site secrets\nrecord(job) · labRun(job)\n  withCredentials(owner keys) per run",
   "originalText": "class Worker (jobs/worker.ts)\n──────────\nid = host-pid-uuid8\nstart() · poke() · stop(graceMs = 30 s)\nrun(): claim → execute | idle backoff\n  2 s ×2 → 10 s, ±10% jitter\nexecute(job):\n  heartbeat every max(1 s, lease/3)\n  margin check: abort if no ack > 80% lease\n  deadline LAB_JOB_DEADLINE_MS (6 min)\n  finish: flush progress, then fenced write\n  retry unless RecordError or aborted\n  finally: unregister site secrets\nrecord(job) · labRun(job)\n  withCredentials(owner keys) per run",
   "fontSize": 14,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r-35",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 13
