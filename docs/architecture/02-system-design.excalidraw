   "updated": 1760600000000,
   "link": null,
   "locked": false,
   "text": "Exactly one owner writes a result\n\nEvery terminal write is fenced by locked_by =\nworkerId, so a worker whose lease lapsed (zombie)\nwrites nothing.",
   "originalText": "Exactly one owner writes a result\n\nEvery terminal write is fenced by locked_by =\nworkerId, so a worker whose lease lapsed (zombie)\nwrites nothing.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r-64",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 14
