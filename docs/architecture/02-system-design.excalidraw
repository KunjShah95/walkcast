   "link": null,
   "locked": false,
   "text": "Passwords never sit in the queue in clear\n\nSealed with LAB_SECRET_KEY (AES-256-GCM); only\nworkers open it; cleared when the job ends. Traces\nand captions show {{secret:site_password}}.",
   "originalText": "Passwords never sit in the queue in clear\n\nSealed with LAB_SECRET_KEY (AES-256-GCM); only\nworkers open it; cleared when the job ends. Traces\nand captions show {{secret:site_password}}.",
   "fontSize": 15,
