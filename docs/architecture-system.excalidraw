      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "enqueueLimited (atomic)\nlimit check and insert, one statement;\ntwo instances cannot both win;\nidentifies idempotent resubmit",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "n000073",
