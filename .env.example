# Walkcast environment variables. Copy to .env and fill in what you need.
# None are required to start; see README.md.

# --- Web analytics (Vercel Web Analytics, opt-in) ---
# Without VITE_VERCEL_ANALYTICS_DSN nothing is loaded and no event leaves the browser.
# VITE_VERCEL_ANALYTICS_DSN=
# Self-hosters proxying the script through their own domain:
# VITE_VERCEL_ANALYTICS_SCRIPT_SRC=/_vercel/insights/script.js
# VITE_VERCEL_ANALYTICS_ENDPOINT=

# --- Hosting ---
# LAB_SITE_URL=https://your-domain
# LAB_HOST=0.0.0.0
# LAB_TRUST_PROXY=1

# --- Accounts / storage ---
# SUPABASE_DB_URL=postgres://...
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Recording / narration ---
# LAB_VOICE=slt
# LAB_TTS_PROVIDER=flite
# LAB_TTS_LANGUAGE=en-IN
# The provider and its voice are picked per recording in the dashboard. LAB_TTS_LANGUAGE is only the
# fallback for providers whose voice ids don't carry a locale (Sarvam, Bhashini, Reverie, a custom
# endpoint): where the voice decides — "en-US-JennyNeural" is US English, and Google/Azure/Polly
# reject a language that disagrees with the voice.
# LAB_FFMPEG=ffmpeg

# --- Cloud narration (optional) ---
# The provider and its voice are chosen per recording in the dashboard's voice picker; these keys
# only decide whether that provider can speak at all. The server can also hold them at runtime
# (Settings → API keys) instead of in this file.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# GOOGLE_TTS_API_KEY=
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=
# AWS_REGION=ap-south-1
# MURF_API_KEY=
# SARVAM_API_KEY=
# REVERIE_API_KEY=
# REVERIE_APP_ID=
# BHASHINI_API_KEY=
# BHASHINI_USER_ID=
# LAB_TTS_ENDPOINT=
# LAB_TTS_API_KEY=

# --- Secrets ---
# LAB_SECRET_KEY=  # openssl rand -base64 32

# --- Email (Resend) ---
# RESEND_API_KEY=        # https://resend.com/api-keys
# RESEND_FROM=no-reply@yourdomain.com