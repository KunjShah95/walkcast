# Copy to .env and fill in what you use. Nothing here is required for local use:
# without a database URL, Walkcast keeps accounts and the queue in .lab/store.json and media in recordings/.

# --- Database: Supabase Postgres (Project Settings → Database → connection string)
SUPABASE_DB_URL=
# Same thing under the generic name; either works.
# DATABASE_URL=

# --- Your Supabase project URL (Project Settings → API), used for sign-in and storage
SUPABASE_URL=

# --- Sign-in: Supabase Auth (Project Settings → API). Add <LAB_SITE_URL>/auth/callback to
#     Authentication → URL Configuration → Redirect URLs; turn on Google under Authentication → Providers.
SUPABASE_ANON_KEY=
# LAB_AUTH_PROVIDER=local   # use the built-in accounts even when Supabase is configured

# --- Media: Supabase Storage over its S3 protocol (Storage → S3 Connection)
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=
SUPABASE_STORAGE_BUCKET=recordings
# ...or an AWS S3 bucket (credentials from the ECS task role or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=

# --- Queue: seals site passwords in jobs; must be the same on web and workers.  openssl rand -base64 32
LAB_SECRET_KEY=

# --- Web
LAB_SITE_URL=http://127.0.0.1:4320
# LAB_HOST=0.0.0.0           # listen on all interfaces (containers)
# LAB_TRUST_PROXY=1          # behind an ALB / reverse proxy
# LAB_WORKER=off             # web-only; run `npm run lab -- worker` separately
# LAB_AUTH=off               # local only: no sign-in needed
# Built-in accounts only (without Supabase Auth):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Limits
# LAB_MAX_ACTIVE_JOBS=1
# LAB_RECORDINGS_PER_DAY=20
# LAB_RUNS_PER_DAY=100
# LAB_JOB_DEADLINE_MS=360000
