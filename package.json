{
  "name": "browser-agent-failure-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Turn browser-agent failures into classified, reproducible regression fixtures.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
