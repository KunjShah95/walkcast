{
  "name": "walkcast",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "walkcast": "bin/walkcast.mjs"
  },
  "description": "Turn browser-agent failures into classified, reproducible regression fixtures.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lab": "tsx apps/desktop/cli.ts",
    "app": "node --import tsx apps/desktop/cli.ts app",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/desktop/dashboard --noEmit && tsc -p apps/web --noEmit",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "node --import tsx apps/web/build.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts",
    "web:indexnow": "node --import tsx apps/web/indexnow.ts",
    "experiment": "tsx apps/desktop/cli.ts experiment",
    "ui:build": "vite build --config apps/desktop/dashboard/vite.config.ts",
    "ui:dev": "vite --config apps/desktop/dashboard/vite.config.ts",
    "ui": "npm run ui:build && tsx apps/desktop/cli.ts ui",
    "dev": "npm run web:dev -- --open",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:stage": "node --import tsx apps/desktop/scripts/stage-sidecar.ts",
    "cli": "node --import tsx apps/desktop/cli.ts",
    "doctor": "node --import tsx apps/desktop/cli.ts doctor",
    "walkcast": "node bin/walkcast.mjs",
    "qa": "npm run typecheck && npm run ui:build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@browserbasehq/stagehand": "4.2.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "motion": "14.2.0",
    "openai": "7.33.0",
    "playwright": "1.56.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "22.18.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "rolldown": "1.2.14",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
