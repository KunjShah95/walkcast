{
  "name": "walkcast",
  "version": "0.1.0",
  "private": true,
  "description": "Turn browser-agent failures into classified, reproducible regression fixtures.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lab": "tsx src/cli.ts",
    "app": "tsx src/app/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p dashboard --noEmit",
    "experiment": "tsx src/cli.ts experiment",
    "ui:build": "vite build --config dashboard/vite.config.ts",
    "ui:dev": "vite --config dashboard/vite.config.ts",
    "ui": "npm run ui:build && tsx src/cli.ts ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@browserbasehq/stagehand": "4.2.1",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "motion": "14.2.0",
    "openai": "7.33.0",
    "playwright": "1.56.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
