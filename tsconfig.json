{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["packages", "apps/desktop/server", "apps/desktop/cli.ts", "apps/desktop/sidecar.ts", "apps/desktop/scripts", "test", "vercel.ts"]
}
