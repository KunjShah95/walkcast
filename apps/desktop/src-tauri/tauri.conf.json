{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "walkcast",
  "version": "0.7.0",
  "identifier": "com.walkcast.desktop",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://127.0.0.1:4320",
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run ui:build && npm run desktop:stage"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/walkcast-node"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "walkcast"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFQjM1Q0ZDRUJCQTZDMDcKUldRSGJMcnIvRnl6bmpYbXJrcjJpUUVSdFloL01GcHZqNEJQYy9UY3RlYy9LU3c3bTB6WDhjaEsK",
      "endpoints": [
        "https://github.com/KunjShah95/walkcast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
