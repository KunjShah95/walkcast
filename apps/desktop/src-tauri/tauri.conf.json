{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "walkcast",
  "version": "0.1.0",
  "identifier": "com.walkcast.desktop",
  "build": {
    "frontendDist": "../dashboard/dist",
    "devUrl": "http://127.0.0.1:4320",
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run ui:build && npm run desktop:stage"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/walkcast-node"
    ],
    "resources": {
      "sidecar/": "sidecar/"
    }
  }
}
