{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "deep-link",
  "description": "Lets the app receive the walkcast:// callback that browser sign-in returns through, and read the URL the OS launched it with at startup. Without a fixed loopback port, a busy 4317 can no longer strand the flow.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:4317/*",
      "http://127.0.0.1:4318/*",
      "http://127.0.0.1:4319/*",
      "http://127.0.0.1:4320/*",
      "http://127.0.0.1:4321/*",
      "http://127.0.0.1:4322/*",
      "http://127.0.0.1:4323/*",
      "http://127.0.0.1:4324/*",
      "http://127.0.0.1:4325/*",
      "http://127.0.0.1:4326/*"
    ]
  },
  "permissions": [
    "deep-link:default"
  ]
}
