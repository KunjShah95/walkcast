{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run ui:build && npm run site:build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/app", "destination": "$APP_ORIGIN/app" },
    { "source": "/app/:path*", "destination": "$APP_ORIGIN/app/:path*" },
    { "source": "/api/:path*", "destination": "$APP_ORIGIN/api/:path*" },
    { "source": "/files/:path*", "destination": "$APP_ORIGIN/files/:path*" },
    { "source": "/auth/:path*", "destination": "$APP_ORIGIN/auth/:path*" },
    { "source": "/start", "destination": "$APP_ORIGIN/start" },
    { "source": "/signup", "destination": "$APP_ORIGIN/signup" },
    { "source": "/login", "destination": "$APP_ORIGIN/login" },
    { "source": "/forgot", "destination": "$APP_ORIGIN/forgot" },
    { "source": "/healthz", "destination": "$APP_ORIGIN/healthz" }
  ],
  "headers": [
    {
      "source": "/404.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}